<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:padding="16dp">

        <TextView
            android:id="@+id/totalTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today: --"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btnToday"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="4dp"
                android:text="Today" android:textSize="12sp"
                android:textColor="@color/colorPrimary" android:background="#FFFFFF"/>

            <Button android:id="@+id/btnPickDate"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp"
                android:text="History" android:textSize="12sp"
                android:textColor="@color/colorPrimary" android:background="#FFFFFF"/>

            <Button android:id="@+id/btnWeekly"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp"
                android:text="Week" android:textSize="12sp"
                android:textColor="@color/colorPrimary" android:background="#FFFFFF"/>

            <Button android:id="@+id/btnMonthly"
                android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginStart="4dp"
                android:text="Month" android:textSize="12sp"
                android:textColor="@color/colorPrimary" android:background="#FFFFFF"/>

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:gravity="center"
        android:text="No data yet.\nTap Refresh to collect stats."
        android:visibility="gone"
        android:textColor="@color/colorGray"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="60dp"/>

    <Button
        android:id="@+id/fabRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⟳  Refresh Now"
        android:background="@color/colorPrimary"
        android:textColor="#FFFFFF"
        android:padding="14dp"/>

</LinearLayout>
